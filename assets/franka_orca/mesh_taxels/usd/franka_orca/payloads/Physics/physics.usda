            float newton:damping = 0.00005235988
            float newton:friction = 0.2
            float newton:velocityLimit = 150.11494
            uniform token physics:axis = "Z"
            custom rel physics:body0
            append rel physics:body0 = </franka_orca/Geometry/base/fr3_link0>
            custom rel physics:body1
            append rel physics:body1 = </franka_orca/Geometry/base/fr3_link0/fr3_link1>
